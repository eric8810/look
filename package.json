{
  "name": "dlook",
  "version": "0.1.0",
  "description": "A minimal terminal file previewer (markdown + code/text) built with vue-tui",
  "type": "module",
  "bin": {
    "dlook": "dist/terminal.cjs",
    "preview": "dist/terminal.cjs"
  },
  "files": [
    "dist/terminal.cjs",
    "README.md"
  ],
  "scripts": {
    "build": "vite build --mode terminal",
    "typecheck": "tsc --noEmit",
    "dev": "node dist/terminal.cjs",
    "build:binary": "pnpm build && node scripts/build-binary.mjs",
    "prepublishOnly": "pnpm build",
    "test:e2e": "bash test/e2e/run-acceptance.sh"
  },
  "keywords": [
    "cli",
    "terminal",
    "tui",
    "markdown",
    "preview",
    "pager",
    "syntax-highlight",
    "shiki",
    "vue-tui"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@shikijs/core": "1.29.2",
    "@shikijs/engine-javascript": "1.29.2",
    "@shikijs/langs": "1.29.2",
    "@shikijs/themes": "1.29.2",
    "@simon_he/vue-tui": "^1.1.3",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "postject": "^1.0.0-alpha.6",
    "shiki": "^1.24.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
